# Configurar únicamente en Render, nunca publicar credenciales reales.
NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
SESSION_SECRET=REEMPLAZAR_CON_SECRETO_ALEATORIO_DE_64_CARACTERES_O_MAS
SESSION_MAX_AGE_SECONDS=43200

